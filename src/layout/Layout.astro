---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/sprite.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // Blocking on purpose: sets the theme before first paint so the page
      // never flashes light on its way to the dark default.
      if ((sessionStorage.getItem("theme") || "dark") === "dark") {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body
    class="flex min-h-screen flex-col bg-zinc-50 text-black dark:bg-black dark:text-white"
  >
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<script>
  const toggle = document.getElementById("theme-toggle");
  const icon = document.getElementById("theme-icon")!;
  const html = document.documentElement;

  const syncIcon = () => {
    const isDark = html.classList.contains("dark");
    icon.className = isDark ? "fa-regular fa-sun" : "fa-solid fa-moon";
    toggle?.setAttribute(
      "aria-label",
      isDark ? "Switch to light theme" : "Switch to dark theme",
    );
  };

  // The head script already applied the class; just mirror it in the icon.
  syncIcon();

  toggle?.addEventListener("click", () => {
    html.classList.toggle("dark");
    sessionStorage.setItem(
      "theme",
      html.classList.contains("dark") ? "dark" : "light",
    );
    syncIcon();
  });
</script>
