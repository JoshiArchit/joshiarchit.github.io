---
// TODO: Move it to Steam component later once architected
let steamData: {
  personaname: string;
  avatarfull: string;
  personastate: number;
} | null = null;

try {
  const key = import.meta.env.STEAM_API_KEY;
  const steamId = import.meta.env.STEAM_ID_64;
  const res = await fetch(
    `https://api.steampowered.com/ISteamUser/GetPlayerSummaries/v0002/?key=${key}&steamids=${steamId}`,
  );
  const data = await res.json();
  steamData = data.response.players[0] ?? null;
  console.error(steamData?.personaname);
} catch (err) {
  console.error("Steam API fetch failed during build:", err);
}
---

<header
  class="sticky top-0 z-100 flex h-[10vh] w-full items-center justify-between border-b border-slate-900 bg-zinc-100 px-24 font-light dark:bg-gray-950"
>
  <div class="flex items-center gap-4 divide-x-2">
    <section class="anchors flex gap-5 text-base">
      <a href="#">Home</a>
      <a href="#about">About</a>
      <a href="#projects">Projects</a>
      <a href="#contact">Contact</a>
    </section>
  </div>
  <div class="flex gap-4">
    <button
      id="steam"
      class="hover:animate-pulse hover:cursor-pointer"
      title={steamData?.personaname ?? "Steam"}
      data-steam={JSON.stringify(steamData)}
    >
      <i id="steam-icon" class="fa-brands fa-steam"></i>
    </button>
    <button id="theme-toggle" class="hover:animate-bounce hover:cursor-pointer">
      <i id="theme-icon" class="fa-regular fa-sun"></i>
    </button>
  </div>
</header>

