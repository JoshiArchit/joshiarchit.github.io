---
import degrees from "../../data/degrees.json";

const colorMap: Record<string, string> = {
  orange: "bg-orange-600 dark:bg-orange-400",
  orangeBullet: "text-orange-600 dark:text-orange-400",
  blue: "bg-blue-600 dark:bg-blue-400",
  blueBullet: "text-blue-600 dark:text-blue-400",
};
---

<section
  id="education"
  class="relative flex section-shell flex-1 flex-col items-center gap-8 pb-12"
>
  <div class="section-content flex flex-col gap-8 md:flex-row md:gap-0">
    <!-- pr-12 keeps the right-aligned date ranges off the column divider. -->
    <section class="flex flex-col gap-8 md:w-3/5 md:pr-12">
      <h2 class="text-2xl font-semibold sm:text-3xl lg:text-4xl">Education</h2>
      <div
        class="relative flex flex-col gap-8 border-l border-slate-700 pl-6 sm:pl-8"
      >
        {
          degrees.map((degree) => (
            <div class="relative flex flex-col gap-2">
              <div
                class={`absolute -left-8 h-4 w-4 rounded-full sm:-left-10 ${colorMap[degree.background]}`}
              />

              <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between">
                <div class="flex-col">
                  <h3 class="text-lg font-semibold sm:text-xl">
                    {degree.degree}
                  </h3>
                  <h4>{degree.major}</h4>
                </div>
                <span class="text-sm text-slate-700 dark:text-slate-400">
                  {degree.start} – {degree.end}
                </span>
              </div>

              <div class="flex flex-wrap items-center gap-2 text-slate-700 dark:text-slate-400">
                <i class="fa-solid fa-graduation-cap" />
                <span>{degree.university}</span>
                <span>·</span>
                <span>{degree.location}</span>
              </div>

              <div>
                <ul class="flex flex-col gap-1 text-sm text-slate-700 dark:text-slate-300">
                  {degree.bullets.map((bullet) => (
                    <li class="flex gap-2">
                      <i
                        class={`fa-solid fa-chevron-right mt-1 ${colorMap[degree.bulletColor]}`}
                      />
                      {bullet}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section
      id="awards"
      class="flex flex-col gap-4 border-t border-slate-700 pt-8 md:w-2/5 md:border-t-0 md:border-l md:pt-0 md:pl-12"
    >
      <h2 class="text-2xl font-semibold sm:text-3xl lg:text-4xl">
        Awards & Certifications
      </h2>

      <div class="flex flex-col gap-2">
        <span
          class="flex -translate-x-1.5 items-center gap-2 text-sm font-semibold tracking-widest text-slate-700 uppercase dark:text-slate-500"
        >
          <i class="fa-solid fa-trophy text-amber-400"></i>Awards
        </span>
        <ul class="flex flex-col gap-1 border-l border-slate-700 pl-4 text-sm">
          <li>IBM Service Excellence Award — Q1 2021</li>
          <li>RIT Residence Life Community Builder — 2024</li>
          <li>RIT Residence Life Team Player — 2024</li>
        </ul>
      </div>

      <div class="flex flex-col gap-2">
        <span
          class="flex -translate-x-1.5 items-center gap-2 text-sm font-semibold tracking-widest text-slate-700 uppercase dark:text-slate-500"
        >
          <i class="fa-solid fa-certificate text-blue-400"></i>Certifications
        </span>
        <ul class="flex flex-col gap-1 border-l border-slate-700 pl-4 text-sm">
          <li>AWS Certified Cloud Practitioner</li>
          <li>Microsoft Certified: Azure Data Fundamentals</li>
          <li>Microsoft Certified: Azure Fundamentals</li>
        </ul>
      </div>
    </section>
  </div>

  <div class="section-content border border-slate-900"></div>
</section>
